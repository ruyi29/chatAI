# API
DATABASE_URL="mysql://chatai:chatai_pass@localhost:3306/chatai"
SHADOW_DATABASE_URL="mysql://root:chatai_root@localhost:3306/chatai_shadow"
PORT=4000
WEB_ORIGIN="http://localhost:5173,http://localhost:5174"


# AI provider
# Options:
# - mock: 本地模拟（默认，用于开发与离线调试）
# - openai-compatible: 通用的 OpenAI 兼容 API（例如 OpenAI、部分托管服务）
# 设置为 openai-compatible 并提供 API Key 即可连接真实模型。
# AI_PROVIDER=mock

# OpenAI-compatible 提示（示例）
# AI_BASE_URL="https://api.openai.com/v1"
# AI_API_KEY=""
# AI_MODEL="gpt-4o-mini"

# 代理设置（可选）
# 如果你的环境需要走代理访问外部模型 API，可配置下面任意一个：
# HTTPS_PROXY="http://127.0.0.1:7890"
# HTTP_PROXY="http://127.0.0.1:7890"

# Google Gemini 示例：
# 将提供者设置为 gemini，并将 AI_BASE_URL 指向 Google Generative Language API
# 示例 URL（根据你使用的版本选择 v1 或 v1beta2）：
# AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# 使用 API Key 时可将其放在 AI_API_KEY，后端会把它作为查询参数 `?key=...` 发送。
# 注意：若你使用 OAuth2 访问令牌，请把令牌设置为 AI_API_KEY，并把 AI_BASE_URL 指向合适的端点。
# AI_PROVIDER=gemini
# AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# AI_API_KEY="<YOUR_GOOGLE_API_KEY_OR_ACCESS_TOKEN>"
# AI_MODEL="gemini-2.5-flash"